# Deliverance — LOCAL DEVELOPMENT image. (Production uses ./Dockerfile, built by Render.)
# Ruby pinned to 3.3.6 to match .ruby-version. Node is here for the UploadThing helper.
FROM ruby:3.3.6-slim

ENV LANG=C.UTF-8 \
    TZ=Asia/Manila \
    BUNDLE_PATH=/usr/local/bundle

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
      build-essential libpq-dev postgresql-client git curl libyaml-dev tzdata \
      nodejs npm \
 && rm -rf /var/lib/apt/lists/*

RUN gem install rails -v 8.1.3 && gem install bundler

WORKDIR /app

CMD ["bash"]
