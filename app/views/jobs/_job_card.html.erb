<%= link_to job_path(job), class: "group block rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:border-cyan-400/40 hover:bg-white/[0.07]" do %>
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-semibold text-slate-100 group-hover:text-white"><%= job.title %></h3>
      <p class="mt-0.5 text-sm text-slate-400"><%= job.poster.display_name %></p>
    </div>
    <span class="whitespace-nowrap rounded-md bg-cyan-500/10 px-2 py-1 text-xs font-medium text-cyan-200">
      <%= job.compensation_display %>
    </span>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 text-xs">
    <span class="rounded-full border border-indigo-400/30 bg-indigo-400/10 px-2.5 py-1 text-indigo-200"><%= job.work_arrangement_label %></span>
    <span class="rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-slate-300"><%= job.employment_type_label %></span>
    <% if job.location.present? %>
      <span class="rounded-full border border-white/15 bg-white/5 px-2.5 py-1 text-slate-400">📍 <%= job.location %></span>
    <% end %>
  </div>
<% end %>
