<div id="<%= dom_id(message) %>" class="rounded-xl border border-white/10 bg-white/5 px-3 py-2">
  <p class="text-xs text-slate-400">
    <span class="text-slate-200"><%= message.sender.display_name %></span> ·
    <%= message.created_at.strftime("%b %-d, %-l:%M%P") %>
  </p>
  <p class="mt-0.5 whitespace-pre-line text-sm text-slate-100"><%= message.body %></p>
</div>
