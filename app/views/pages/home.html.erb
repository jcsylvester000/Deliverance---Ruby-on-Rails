<% content_for :title, "Deliverance — Looking for a Job, We can Deliver" %>
<% content_for :full_bleed, true %>

<div data-controller="join reveal" data-action="keydown.esc->join#close">

  <%# ============================ HERO ============================ %>
  <section id="join" class="relative flex min-h-[90vh] items-center overflow-hidden">
    <%# Background image carousel %>
    <div class="absolute inset-0" data-controller="carousel"
         data-carousel-mode-value="fade" data-carousel-interval-value="5000"
         data-action="mouseenter->carousel#pause mouseleave->carousel#resume">
      <% [
           ["1522071820081-009f0129c71c", "hero-team",    "A team collaborating around a laptop"],
           ["1521737604893-d14cc237f11d", "hero-hire",    "Colleagues shaking hands after an interview"],
           ["1499750310107-5fef28a66643", "hero-remote",  "Someone working remotely on a laptop"],
           ["1600880292203-757bb62b4baf", "hero-office",  "A bright modern office with people working"]
         ].each_with_index do |(id, seed, alt), i| %>
        <div data-carousel-target="slide"
             class="absolute inset-0 transition-opacity duration-1000 <%= i.zero? ? "opacity-100 z-10" : "opacity-0" %>">
          <%= photo_tag id, seed: seed, alt: alt, width: 2000, height: 1200,
                class: "h-full w-full object-cover", loading: (i.zero? ? "eager" : "lazy") %>
        </div>
      <% end %>
      <%# Readability overlays %>
      <div class="absolute inset-0 z-20 bg-gradient-to-br from-slate-950 via-slate-950/85 to-slate-950/40"></div>
      <div class="absolute inset-0 z-20 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/30"></div>
      <%# Floating accent blobs %>
      <div class="pointer-events-none absolute -right-24 top-10 z-20 h-80 w-80 rounded-full bg-cyan-500/20 blur-3xl blobby"></div>
      <div class="pointer-events-none absolute -left-24 bottom-0 z-20 h-80 w-80 rounded-full bg-indigo-500/20 blur-3xl floaty-slow"></div>

      <%# Carousel dots %>
      <div class="absolute bottom-6 left-1/2 z-30 flex -translate-x-1/2 gap-2">
        <% 4.times do |i| %>
          <button type="button" data-carousel-target="dot" data-index="<%= i %>"
                  data-action="carousel#to" aria-label="Slide <%= i + 1 %>"
                  class="h-2.5 rounded-full transition-all duration-300 <%= i.zero? ? "w-6 bg-cyan-400" : "w-2.5 bg-white/30" %>"></button>
        <% end %>
      </div>
    </div>

    <%# Hero content %>
    <div class="relative z-30 mx-auto w-full max-w-6xl px-4 py-24">
      <div class="max-w-2xl">
        <p class="anim-fade-up mb-4 inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-3 py-1 text-xs font-medium text-cyan-200 backdrop-blur">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-cyan-400"></span>
          </span>
          Gigs · Projects · Full-time with benefits
        </p>

        <h1 class="anim-fade-up d1 font-display text-5xl font-bold leading-[1.05] tracking-tight sm:text-7xl">
          Looking for work?<br><span class="gradient-text">We can Deliver.</span>
        </h1>

        <p class="anim-fade-up d2 mt-5 text-lg font-medium text-slate-200">
          Looking for a Job, We can Deliver.
        </p>
        <p class="anim-fade-up d3 mt-3 max-w-xl text-slate-300">
          Post temporary, project-based, or full-time roles — remote, hybrid, or on-site — and track
          every applicant like a pipeline. Browsing is open to everyone; you register when you're ready to apply.
        </p>

        <div class="anim-fade-up d4 mt-8 flex flex-wrap items-center gap-3">
          <button type="button" data-action="join#open"
            class="pulse-glow rounded-xl bg-gradient-to-r from-cyan-400 to-indigo-500 px-6 py-3.5 font-semibold text-slate-950 shadow-lg shadow-cyan-500/30 transition hover:brightness-110">
            Login / Become a Member
          </button>
          <a href="#board" class="rounded-xl border border-white/20 bg-white/5 px-6 py-3.5 font-medium text-slate-100 backdrop-blur transition hover:bg-white/10">
            Browse the board →
          </a>
        </div>

        <div class="anim-fade-up d5 mt-10 flex items-center gap-4">
          <div class="flex -space-x-3">
            <% [12, 15, 33, 45, 47].each_with_index do |n, i| %>
              <%= avatar_tag n, seed: "hero-face-#{i}", alt: "Member", size: 80,
                    class: "h-10 w-10 rounded-full border-2 border-slate-950 object-cover" %>
            <% end %>
          </div>
          <p class="text-sm text-slate-300">Join <span class="font-semibold text-white">1,200+</span> posters and applicants already delivering.</p>
        </div>
      </div>
    </div>
  </section>

  <%# ======================= TRUSTED-BY MARQUEE ======================= %>
  <section class="border-y border-white/10 bg-slate-900/40 py-6">
    <div class="mx-auto max-w-6xl px-4">
      <p class="mb-4 text-center text-xs uppercase tracking-widest text-slate-500">Trusted by teams shipping work everywhere</p>
      <div class="relative overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
        <div class="marquee-track gap-12 pr-12 text-lg font-semibold text-slate-400">
          <% names = %w[Northwind Acme·Labs Globex Umbra·Co Pinnacle Vertex Lumen Harbor Skyforge Meridian] %>
          <% (names + names).each do |name| %>
            <span class="font-display whitespace-nowrap opacity-70 transition hover:text-slate-200 hover:opacity-100"><%= name %></span>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%# ============================ STATS ============================ %>
  <section class="mx-auto max-w-6xl px-4 py-16" data-reveal>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <% [
           ["members joined",     1200, "+"],
           ["roles filled",        340, "+"],
           ["hrs avg first reply",  24, ""],
           ["would recommend",      98, "%"]
         ].each do |label, to, suffix| %>
        <div class="hover-lift rounded-2xl border border-white/10 bg-white/5 p-6 text-center">
          <div class="font-display text-4xl font-bold text-white">
            <span data-controller="countup" data-countup-to-value="<%= to %>" data-countup-suffix-value="<%= suffix %>">0<%= suffix %></span>
          </div>
          <p class="mt-1 text-sm text-slate-400"><%= label %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ======================== HOW IT WORKS ======================== %>
  <section class="mx-auto max-w-6xl px-4 py-12" data-reveal>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">From hello to hired in three steps</h2>
      <p class="mt-3 text-slate-400">No noise, no dead-end applications — just a clean path from posting to pipeline.</p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      <% [
           ["01", "🧩", "Tell us who you are", "A 30-second get-to-know-you sets up a dashboard shaped around whether you post work or look for it."],
           ["02", "📮", "Post or browse", "Posters publish up to ten live roles; everyone can browse the board freely and apply when ready."],
           ["03", "📈", "Track like a pipeline", "Move applicants through stages, schedule interviews, message, and onboard — all in one place."]
         ].each_with_index do |(num, icon, title, body), i| %>
        <div data-reveal style="transition-delay: <%= i * 90 %>ms"
             class="hover-lift card-sheen relative rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.07] to-white/[0.02] p-6">
          <div class="mb-4 flex items-center justify-between">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-gradient-to-br from-cyan-400/20 to-indigo-500/20 text-2xl"><%= icon %></span>
            <span class="font-display text-3xl font-bold text-white/10"><%= num %></span>
          </div>
          <h3 class="font-display text-lg font-semibold"><%= title %></h3>
          <p class="mt-2 text-sm text-slate-400"><%= body %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ==================== WHY BECOME A MEMBER ==================== %>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-cyan-300">Why become a member</p>
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Two dashboards. One less headache.</h2>
      <p class="mt-3 text-slate-400">Whether you're hiring or job-hunting, Deliverance gives you a workspace built for exactly that.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <%# Posters %>
      <div data-reveal class="hover-lift overflow-hidden rounded-3xl border border-white/10 bg-white/5">
        <div class="relative h-48 overflow-hidden">
          <%= photo_tag "1600880292203-757bb62b4baf", seed: "why-poster", alt: "A hiring team reviewing candidates",
                width: 1200, height: 500, class: "h-full w-full object-cover" %>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 to-transparent"></div>
          <span class="absolute left-5 top-5 rounded-full border border-cyan-400/30 bg-slate-950/70 px-3 py-1 text-xs font-medium text-cyan-200 backdrop-blur">📢 For Job Posters</span>
        </div>
        <div class="p-6">
          <h3 class="font-display text-xl font-semibold">Hire without the spreadsheet chaos</h3>
          <ul class="mt-4 space-y-3 text-sm text-slate-300">
            <% ["Post up to 10 live roles with rich detail and pay ranges",
                "A drag-through pipeline: applied → review → interview → offer → hired",
                "Schedule interviews with a built-in calendar and .ics invites",
                "Accept-only messaging keeps your inbox free of spam"].each do |point| %>
              <li class="flex gap-3"><span class="mt-0.5 text-cyan-300">✓</span><span><%= point %></span></li>
            <% end %>
          </ul>
        </div>
      </div>

      <%# Applicants %>
      <div data-reveal style="transition-delay:90ms" class="hover-lift overflow-hidden rounded-3xl border border-white/10 bg-white/5">
        <div class="relative h-48 overflow-hidden">
          <%= photo_tag "1521737604893-d14cc237f11d", seed: "why-applicant", alt: "A candidate celebrating a new role",
                width: 1200, height: 500, class: "h-full w-full object-cover" %>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 to-transparent"></div>
          <span class="absolute left-5 top-5 rounded-full border border-indigo-400/30 bg-slate-950/70 px-3 py-1 text-xs font-medium text-indigo-200 backdrop-blur">🎯 For Applicants</span>
        </div>
        <div class="p-6">
          <h3 class="font-display text-xl font-semibold">Apply once, then actually track it</h3>
          <ul class="mt-4 space-y-3 text-sm text-slate-300">
            <% ["Browse every open role for free — register only when you apply",
                "Watch your application move through each stage in real time",
                "Get interview invites, reminders, and calendar files automatically",
                "Onboard securely with document upload once you're hired"].each do |point| %>
              <li class="flex gap-3"><span class="mt-0.5 text-indigo-300">✓</span><span><%= point %></span></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>

    <%# Feature tiles %>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% [
           ["🗂️", "Pipeline CRM", "Every applicant as a card you can move, review, and act on."],
           ["📅", "Interviews & calendar", "Schedule, reschedule, cancel — with downloadable invites."],
           ["💬", "Accept-only messaging", "Conversations start only when both sides opt in. Group chats too."],
           ["🔔", "Real-time notifications", "Live updates the moment something changes on your roles."],
           ["📤", "Secure onboarding", "Collect the documents you need once a candidate is hired."],
           ["🧭", "Discovery", "Opt in to be found by posters looking for your skills."]
         ].each_with_index do |(icon, title, body), i| %>
        <div data-reveal style="transition-delay: <%= (i % 3) * 70 %>ms"
             class="hover-lift rounded-2xl border border-white/10 bg-white/5 p-5">
          <span class="text-2xl"><%= icon %></span>
          <h4 class="mt-3 font-semibold"><%= title %></h4>
          <p class="mt-1 text-sm text-slate-400"><%= body %></p>
        </div>
      <% end %>
    </div>

    <div class="mt-10 text-center" data-reveal>
      <%= link_to "See everything you get →", membership_path,
            class: "inline-flex rounded-xl border border-white/15 bg-white/5 px-6 py-3 font-medium text-slate-100 transition hover:bg-white/10" %>
    </div>
  </section>

  <%# ========================== OPEN ROLES ========================== %>
  <section id="board" class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex items-center justify-between" data-reveal>
      <div>
        <h2 class="font-display text-3xl font-bold sm:text-4xl">Open roles</h2>
        <p class="mt-2 text-slate-400">Fresh from the board — browse freely, apply when you're ready.</p>
      </div>
      <%= link_to "Browse all →", jobs_path, class: "shrink-0 text-sm font-medium text-cyan-300 hover:text-cyan-200" %>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      <% if @jobs.present? && @jobs.any? %>
        <% @jobs.each do |job| %>
          <%= render "jobs/job_card", job: job %>
        <% end %>
      <% else %>
        <div class="col-span-full rounded-2xl border border-dashed border-white/15 bg-white/5 p-12 text-center text-slate-400">
          <p class="text-4xl">🗒️</p>
          <p class="mt-3">No roles are posted yet — check back soon, or
          <button type="button" data-action="join#open" class="font-medium text-cyan-300 hover:text-cyan-200">become a member</button>
          to post one.</p>
        </div>
      <% end %>
    </div>
  </section>

  <%# ========================= TESTIMONIALS ========================= %>
  <section class="mx-auto max-w-6xl px-4 py-16" data-reveal>
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold sm:text-4xl">Loved by both sides of the table</h2>
    </div>
    <div class="relative mx-auto mt-10 max-w-3xl" data-controller="carousel"
         data-carousel-mode-value="swap" data-carousel-interval-value="7000">
      <% [
           ["Deliverance turned our messy hiring email chain into an actual pipeline. We filled two roles in a week.", "Ava Mitchell", "Founder, Meridian Studio", 47],
           ["I could see my application move from ‘applied’ to ‘interview’ in real time. No more silence after applying.", "Daniel Okafor", "Freelance Developer", 33],
           ["The calendar invites and accept-only messaging alone saved me hours. It just feels calm.", "Priya Nair", "Talent Lead, Vertex", 45]
         ].each_with_index do |(quote, name, role, img), i| %>
        <div data-carousel-target="slide" class="<%= "hidden" unless i.zero? %>">
          <figure class="rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.08] to-white/[0.02] p-8 text-center sm:p-10">
            <div class="mb-4 text-4xl text-cyan-400/40">“</div>
            <blockquote class="font-display text-xl font-medium leading-relaxed text-slate-100 sm:text-2xl"><%= quote %></blockquote>
            <figcaption class="mt-6 flex items-center justify-center gap-3">
              <%= avatar_tag img, seed: "t-#{i}", alt: name, size: 96, class: "h-12 w-12 rounded-full object-cover" %>
              <div class="text-left">
                <p class="font-semibold text-white"><%= name %></p>
                <p class="text-sm text-slate-400"><%= role %></p>
              </div>
            </figcaption>
          </figure>
        </div>
      <% end %>

      <div class="mt-6 flex items-center justify-center gap-4">
        <button type="button" data-action="carousel#prev" aria-label="Previous"
                class="grid h-10 w-10 place-items-center rounded-full border border-white/15 text-slate-300 hover:bg-white/10">‹</button>
        <div class="flex gap-2">
          <% 3.times do |i| %>
            <button type="button" data-carousel-target="dot" data-index="<%= i %>" data-action="carousel#to"
                    aria-label="Testimonial <%= i + 1 %>"
                    class="h-2.5 rounded-full transition-all duration-300 <%= i.zero? ? "w-6 bg-cyan-400" : "w-2.5 bg-white/30" %>"></button>
          <% end %>
        </div>
        <button type="button" data-action="carousel#next" aria-label="Next"
                class="grid h-10 w-10 place-items-center rounded-full border border-white/15 text-slate-300 hover:bg-white/10">›</button>
      </div>
    </div>
  </section>

  <%# ========================== FROM THE BLOG ========================== %>
  <% if @articles.present? %>
    <section class="mx-auto max-w-6xl px-4 py-16" data-reveal>
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-display text-3xl font-bold sm:text-4xl">From the blog</h2>
          <p class="mt-2 text-slate-400">Playbooks and stories for posters and applicants alike.</p>
        </div>
        <%= link_to "All articles →", articles_path, class: "shrink-0 text-sm font-medium text-cyan-300 hover:text-cyan-200" %>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <% @articles.each_with_index do |article, i| %>
          <%= link_to article_path(article), data: { reveal: "" }, style: "transition-delay: #{i * 80}ms",
                class: "hover-lift card-sheen group block overflow-hidden rounded-2xl border border-white/10 bg-white/5" do %>
            <div class="relative h-44 overflow-hidden">
              <%= photo_tag article.cover_id, seed: article.slug, alt: article.title, width: 900, height: 500,
                    class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>
              <span class="absolute left-4 top-4 rounded-full bg-slate-950/70 px-2.5 py-1 text-xs font-medium text-cyan-200 backdrop-blur"><%= article.tag %></span>
            </div>
            <div class="p-5">
              <h3 class="font-display font-semibold text-slate-100 group-hover:text-white"><%= article.title %></h3>
              <p class="mt-2 line-clamp-2 text-sm text-slate-400"><%= article.excerpt %></p>
              <p class="mt-4 text-xs text-slate-500"><%= article.read_minutes %> min read</p>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ============================ BIG CTA ============================ %>
  <section class="mx-auto max-w-6xl px-4 py-16" data-reveal>
    <div class="animated-gradient relative overflow-hidden rounded-3xl bg-gradient-to-r from-cyan-500 via-indigo-500 to-fuchsia-500 p-10 text-center sm:p-16">
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/20 blur-3xl floaty"></div>
      <div class="relative">
        <h2 class="font-display text-3xl font-bold text-slate-950 sm:text-5xl">Ready to deliver?</h2>
        <p class="mx-auto mt-4 max-w-xl text-slate-950/80">Set up your dashboard in under a minute. Post a role or start applying today.</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <button type="button" data-action="join#open"
            class="rounded-xl bg-slate-950 px-7 py-3.5 font-semibold text-white shadow-lg transition hover:bg-slate-800">
            Become a Member
          </button>
          <%= link_to "Browse the board", jobs_path,
                class: "rounded-xl border border-slate-950/30 bg-white/20 px-7 py-3.5 font-semibold text-slate-950 backdrop-blur transition hover:bg-white/30" %>
        </div>
      </div>
    </div>
  </section>

  <%# ==================== Get-to-know-you modal (preserved) ==================== %>
  <div class="contents">
    <div data-join-target="overlay" hidden
         class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 p-4 backdrop-blur">
      <div class="w-full max-w-md rounded-2xl border border-white/10 bg-slate-900 p-6 shadow-2xl">

        <div class="mb-5 flex items-center justify-between">
          <div class="flex gap-1 rounded-lg bg-slate-800 p-1 text-sm">
            <button type="button" data-join-target="tab" data-tab="register" data-action="join#showRegister"
                    class="rounded-md px-3 py-1.5 font-medium">Become a Member</button>
            <button type="button" data-join-target="tab" data-tab="login" data-action="join#showLogin"
                    class="rounded-md px-3 py-1.5 font-medium text-slate-400">Log in</button>
          </div>
          <button type="button" data-action="join#close" class="text-slate-400 hover:text-white" aria-label="Close">✕</button>
        </div>

        <%# ---- Register panel ---- %>
        <div data-join-target="register">
          <div class="mb-4 flex gap-1.5">
            <% 4.times do |i| %>
              <span data-join-target="progress" data-index="<%= i %>" class="h-1.5 flex-1 rounded-full bg-slate-700"></span>
            <% end %>
          </div>

          <%= form_with url: user_registration_path, scope: :user, method: :post, data: { turbo: false } do |f| %>
            <%# Step 1 — role (required) %>
            <div data-join-target="step" data-step="0">
              <h3 class="text-lg font-semibold">Are you registering as…</h3>
              <p class="mt-1 text-sm text-slate-400">This shapes your whole dashboard.</p>
              <div class="mt-4 grid gap-3">
                <label class="join-choice"><%= f.radio_button :role, "job_poster", class: "peer sr-only", required: true %><span class="join-card">📢 <b>Job Poster</b><small>I post work and hire</small></span></label>
                <label class="join-choice"><%= f.radio_button :role, "applicant", class: "peer sr-only", required: true %><span class="join-card">🎯 <b>Applicant</b><small>I'm looking for work</small></span></label>
              </div>
            </div>

            <%# Step 2 — organization type (required) %>
            <div data-join-target="step" data-step="1" hidden>
              <h3 class="text-lg font-semibold">Which best describes you?</h3>
              <div class="mt-4 grid gap-3">
                <label class="join-choice"><%= f.radio_button :organization_type, "agency", class: "peer sr-only" %><span class="join-card">🏢 <b>Agency</b><small>I represent multiple clients</small></span></label>
                <label class="join-choice"><%= f.radio_button :organization_type, "individual", class: "peer sr-only" %><span class="join-card">👤 <b>Individual</b><small>Just me</small></span></label>
                <label class="join-choice"><%= f.radio_button :organization_type, "company_representative", class: "peer sr-only" %><span class="join-card">🧑‍💼 <b>Company representative</b><small>HR / hiring for a company</small></span></label>
              </div>
            </div>

            <%# Step 3 — heard from (optional, skippable) %>
            <div data-join-target="step" data-step="2" hidden>
              <h3 class="text-lg font-semibold">How did you hear about us?</h3>
              <p class="mt-1 text-sm text-slate-400">Optional — hit Skip if you'd rather not say.</p>
              <%= f.select :heard_from,
                    ["A friend or colleague", "Social media", "Search engine", "An event", "Other"],
                    { include_blank: "Select…" },
                    class: "mt-4 w-full rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
            </div>

            <%# Step 4 — credentials + submit %>
            <div data-join-target="step" data-step="3" hidden>
              <h3 class="text-lg font-semibold">Create your login</h3>
              <p class="mt-1 text-sm text-slate-400">Last step — then we'll set up your dashboard.</p>
              <div class="mt-4 space-y-3">
                <%= f.email_field :email, required: true, placeholder: "you@example.com", autocomplete: "email",
                      class: "w-full rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
                <%= f.password_field :password, required: true, placeholder: "Password (min 6)", autocomplete: "new-password",
                      class: "w-full rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
                <%= f.password_field :password_confirmation, required: true, placeholder: "Confirm password", autocomplete: "new-password",
                      class: "w-full rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
              </div>
            </div>

            <div class="mt-6 flex items-center justify-between">
              <button type="button" data-join-target="back" data-action="join#back" hidden
                      class="rounded-lg border border-white/15 px-4 py-2 text-sm text-slate-200 hover:bg-white/10">Back</button>
              <div class="ml-auto flex gap-2">
                <button type="button" data-join-target="skip" data-action="join#skip" hidden
                        class="rounded-lg px-4 py-2 text-sm text-slate-400 hover:text-white">Skip</button>
                <button type="button" data-join-target="next" data-action="join#next"
                        class="rounded-lg bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-400">Next</button>
                <%= f.submit "Create account & set up", data: { join_target: "submit" }, hidden: true,
                      class: "rounded-lg bg-cyan-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-400 cursor-pointer" %>
              </div>
            </div>
            <p data-join-target="error" class="mt-3 text-sm text-rose-300" hidden>Please choose an option to continue.</p>
          <% end %>
        </div>

        <%# ---- Login panel ---- %>
        <div data-join-target="login" hidden>
          <h3 class="text-lg font-semibold">Welcome back</h3>
          <%= form_with url: user_session_path, scope: :user, method: :post, data: { turbo: false }, class: "mt-4 space-y-3" do |f| %>
            <%= f.email_field :email, required: true, placeholder: "you@example.com", autocomplete: "email",
                  class: "w-full rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
            <%= f.password_field :password, required: true, placeholder: "Password", autocomplete: "current-password",
                  class: "w-full rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
            <label class="flex items-center gap-2 text-sm text-slate-400">
              <%= f.check_box :remember_me, class: "rounded border-white/20 bg-slate-800" %> Remember me
            </label>
            <%= f.submit "Log in", class: "w-full rounded-lg bg-cyan-500 px-4 py-2.5 font-semibold text-slate-950 hover:bg-cyan-400 cursor-pointer" %>
          <% end %>
        </div>

      </div>
    </div>
  </div>

  <style>
    .join-card { display:flex; flex-direction:column; gap:.1rem; border:1px solid rgba(255,255,255,.1); border-radius:.75rem; padding:.85rem 1rem; cursor:pointer; }
    .join-card small { color:#94a3b8; font-size:.8rem; }
    .join-choice .peer:checked + .join-card { border-color:#22d3ee; background:rgba(34,211,238,.08); box-shadow:0 0 0 1px #22d3ee inset; }
    .join-choice .peer:focus-visible + .join-card { outline:2px solid #22d3ee; }
  </style>

</div><%# /join controller %>
