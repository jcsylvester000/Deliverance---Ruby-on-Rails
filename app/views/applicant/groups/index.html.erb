<% content_for :title, "Group chats" %>

<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between">
    <div>
      <%= link_to "← Messages", conversations_path, class: "text-sm text-slate-400 hover:text-white" %>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">Group chats</h1>
      <p class="mt-1 text-sm text-slate-400">Team up with other applicants to prep and share interview notes.</p>
    </div>
  </div>

  <%= form_with url: applicant_groups_path, method: :post, class: "mt-4 flex gap-2" do %>
    <%= text_field_tag :title, "", placeholder: "New group name (e.g. Weekend gig crew)", required: true,
          class: "flex-1 rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
    <%= submit_tag "Create group", class: "rounded-lg bg-cyan-500 px-4 py-2.5 font-semibold text-slate-950 hover:bg-cyan-400 cursor-pointer" %>
  <% end %>

  <h2 class="mt-8 text-sm font-medium text-slate-400">Your groups</h2>
  <div class="mt-2 space-y-2">
    <% if @my_groups.any? %>
      <% @my_groups.each do |g| %>
        <%= link_to conversation_path(g), class: "flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3 hover:bg-white/[0.07]" do %>
          <span class="font-medium text-slate-100"><%= g.title %></span>
          <span class="text-xs text-slate-500"><%= g.conversation_participants.select(&:accepted?).size %> members</span>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-500">You're not in any groups yet.</p>
    <% end %>
  </div>

  <h2 class="mt-8 text-sm font-medium text-slate-400">Open groups to join</h2>
  <div class="mt-2 space-y-2">
    <% if @open_groups.any? %>
      <% @open_groups.each do |g| %>
        <div class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3">
          <div>
            <span class="font-medium text-slate-100"><%= g.title %></span>
            <span class="ml-2 text-xs text-slate-500"><%= g.conversation_participants.select(&:accepted?).size %> members</span>
          </div>
          <%= button_to "Join", join_applicant_group_path(g), method: :post,
                class: "rounded-md bg-cyan-500 px-3 py-1.5 text-sm font-semibold text-slate-950 hover:bg-cyan-400" %>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-dashed border-white/15 bg-white/5 p-8 text-center text-slate-400">
        No open groups yet. Create the first one above.
      </div>
    <% end %>
  </div>
</div>
