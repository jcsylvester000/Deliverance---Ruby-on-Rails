<% content_for :title, "Find people" %>

<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between">
    <div>
      <%= link_to "← Messages", conversations_path, class: "text-sm text-slate-400 hover:text-white" %>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight">Find people</h1>
      <p class="mt-1 text-sm text-slate-400">Connect with other applicants — compare notes, prep for interviews.</p>
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3">
    <span class="text-sm text-slate-300">
      You are <%= @me_discoverable ? "discoverable" : "hidden" %> to other applicants.
    </span>
    <%= button_to (@me_discoverable ? "Hide me" : "Make me discoverable"), applicant_toggle_discovery_path, method: :patch,
          class: "rounded-md border border-white/15 px-3 py-1.5 text-sm text-slate-200 hover:bg-white/10" %>
  </div>

  <%= form_with url: applicant_people_path, method: :get, data: { turbo: false }, class: "mt-4 flex gap-2" do %>
    <%= text_field_tag :q, params[:q], placeholder: "Search by headline or email…",
          class: "flex-1 rounded-lg border border-white/10 bg-slate-800 px-3 py-2.5 text-slate-100" %>
    <%= submit_tag "Search", class: "rounded-lg border border-white/15 px-4 py-2.5 text-sm text-slate-200 hover:bg-white/10" %>
  <% end %>

  <div class="mt-4 space-y-3">
    <% if @people.any? %>
      <% @people.each do |person| %>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <p class="font-medium text-slate-100"><%= person.display_name %></p>
          <% if person.applicant_profile&.headline.present? %>
            <p class="text-sm text-slate-400"><%= person.applicant_profile.headline %></p>
          <% end %>
          <%= form_with url: conversations_path, method: :post, class: "mt-3 flex gap-2" do %>
            <%= hidden_field_tag :recipient_id, person.id %>
            <%= text_field_tag :body, "", placeholder: "Say hi with a short note…", required: true,
                  class: "flex-1 rounded-lg border border-white/10 bg-slate-800 px-3 py-2 text-sm text-slate-100" %>
            <%= submit_tag "Send request", class: "rounded-lg bg-cyan-500 px-3 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-400 cursor-pointer" %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-dashed border-white/15 bg-white/5 p-8 text-center text-slate-400">
        No discoverable applicants yet. When others opt in, they'll show here.
      </div>
    <% end %>
  </div>
</div>
