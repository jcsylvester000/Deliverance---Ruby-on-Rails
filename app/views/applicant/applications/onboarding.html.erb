<% content_for :title, "Onboarding" %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← My applications", applicant_applications_path, class: "text-sm text-slate-400 hover:text-white" %>
  <h1 class="mt-1 text-2xl font-semibold tracking-tight">You're moving forward 🎉</h1>
  <p class="mt-1 text-sm text-slate-400">
    <span class="text-slate-200"><%= @application.job_posting.title %></span> ·
    <%= @application.job_posting.poster.display_name %>. Drop the basics below to get things moving.
  </p>

  <div class="mt-4 rounded-lg border border-amber-400/20 bg-amber-400/5 p-3 text-xs text-amber-200/90">
    Prototype note: this is a demo upload (stored on UploadThing) — please don't upload a real ID or passport. Any picture works.
  </div>

  <div class="mt-6 space-y-4">
    <% OnboardingDocument::CHECKLIST.each do |item| %>
      <% doc = @documents[item[:kind]] %>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="font-medium text-slate-100">
            <%= item[:label] %>
            <% if item[:required] %><span class="ml-1 text-xs text-rose-300">required</span><% end %>
          </p>
          <% if doc&.attached? %>
            <div class="flex items-center gap-2 text-sm">
              <%= link_to "View", doc.file_url, target: "_blank", rel: "noopener",
                    class: "rounded-md border border-white/15 px-3 py-1.5 text-slate-200 hover:bg-white/10" %>
              <%= button_to "Remove", applicant_application_onboarding_document_path(@application, doc), method: :delete,
                    form: { data: { turbo_confirm: "Remove this file?" } },
                    class: "rounded-md border border-rose-500/30 px-3 py-1.5 text-rose-300 hover:bg-rose-500/10" %>
            </div>
          <% end %>
        </div>

        <% if doc&.attached? %>
          <p class="mt-2 text-sm text-emerald-300">✓ Uploaded — <%= doc.file_name %></p>
        <% end %>

        <%= form_tag applicant_application_onboarding_documents_path(@application),
              multipart: true, data: { controller: "dropzone" }, class: "mt-3" do %>
          <%= hidden_field_tag :kind, item[:kind] %>
          <%= file_field_tag :file, accept: "image/*,.pdf", class: "hidden",
                data: { dropzone_target: "input", action: "dropzone#change" } %>
          <div data-dropzone-target="zone"
               data-action="click->dropzone#open dragover->dropzone#dragover dragleave->dropzone#dragleave drop->dropzone#drop"
               class="cursor-pointer rounded-xl border border-dashed border-white/20 bg-white/[0.02] px-4 py-6 text-center text-sm text-slate-400 transition hover:border-cyan-400/40">
            <span data-dropzone-target="label">
              <%= doc&.attached? ? "Drop a new file to replace, or click to choose" : "Drag &amp; drop a file here, or click to choose" %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @application.onboarding_complete? %>
    <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-emerald-200">
      All required items are in. The hiring team will take it from here.
    </div>
  <% end %>
</div>
