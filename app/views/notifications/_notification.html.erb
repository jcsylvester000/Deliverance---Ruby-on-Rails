<%= link_to notification_link(notification), id: dom_id(notification),
      class: "block rounded-xl border p-4 transition #{notification.read? ? 'border-white/10 bg-white/[0.03]' : 'border-cyan-400/30 bg-cyan-400/[0.06]'}" do %>
  <div class="flex items-start justify-between gap-3">
    <p class="text-sm <%= notification.read? ? 'text-slate-300' : 'text-slate-100' %>">
      <span class="mr-1"><%= notification.icon %></span><%= notification_message(notification) %>
    </p>
    <% unless notification.read? %><span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-cyan-400"></span><% end %>
  </div>
  <p class="mt-1 text-xs text-slate-500"><%= notification.created_at.to_fs(:long) %></p>
<% end %>
