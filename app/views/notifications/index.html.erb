<% content_for :title, "Notifications" %>

<div class="mx-auto max-w-2xl">
  <h1 class="text-2xl font-semibold tracking-tight">Notifications</h1>

  <div id="notifications-list" class="mt-6 space-y-2">
    <% if @notifications.any? %>
      <%= render partial: "notifications/notification", collection: @notifications, as: :notification %>
    <% else %>
      <div class="rounded-2xl border border-dashed border-white/15 bg-white/5 p-10 text-center text-slate-400">
        Nothing yet. Applications, interviews, messages, and more will show up here.
      </div>
    <% end %>
  </div>
</div>
