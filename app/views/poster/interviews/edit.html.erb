<% content_for :title, "Reschedule interview" %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← Interviews", poster_interviews_path, class: "text-sm text-slate-400 hover:text-white" %>
  <h1 class="mt-1 text-2xl font-semibold tracking-tight">Reschedule interview</h1>
  <p class="mt-1 text-sm text-slate-400">
    With <span class="text-slate-200"><%= @interview.applicant.display_name %></span> for
    <span class="text-slate-200"><%= @interview.job_posting.title %></span>. Saving re-notifies the applicant.
  </p>

  <div class="mt-6"><%= render "form" %></div>
</div>
