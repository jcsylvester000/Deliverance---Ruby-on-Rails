<% content_for :title, "Schedule interview" %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← Review applicant", poster_application_path(@application), class: "text-sm text-slate-400 hover:text-white" %>
  <h1 class="mt-1 text-2xl font-semibold tracking-tight">Schedule an interview</h1>
  <p class="mt-1 text-sm text-slate-400">
    With <span class="text-slate-200"><%= @application.applicant.display_name %></span> for
    <span class="text-slate-200"><%= @application.job_posting.title %></span>. This moves them to the interview stage and notifies them.
  </p>

  <div class="mt-6"><%= render "form" %></div>
</div>
