<% content_for :title, "Review applicant" %>

<div class="mx-auto max-w-2xl">
  <%= link_to "← Pipeline", poster_applications_path, class: "text-sm text-slate-400 hover:text-white" %>

  <div class="mt-4 rounded-3xl border border-white/10 bg-white/5 p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight"><%= @application.applicant.display_name %></h1>
        <p class="mt-1 text-sm text-slate-400"><%= @application.applicant.email %></p>
      </div>
      <%= stage_badge(@application) %>
    </div>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2 text-sm">
      <div>
        <dt class="text-slate-500">Role</dt>
        <dd class="text-slate-200"><%= link_to @application.job_posting.title, job_path(@application.job_posting), class: "hover:text-white" %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Applied</dt>
        <dd class="text-slate-200"><%= @application.created_at.to_date.to_fs(:long) %></dd>
      </div>
      <% if @application.applicant.applicant_profile&.headline.present? %>
        <div class="sm:col-span-2">
          <dt class="text-slate-500">Headline</dt>
          <dd class="text-slate-200"><%= @application.applicant.applicant_profile.headline %></dd>
        </div>
      <% end %>
      <% if @application.cover_note.present? %>
        <div class="sm:col-span-2">
          <dt class="text-slate-500">Cover note</dt>
          <dd class="whitespace-pre-line text-slate-200"><%= @application.cover_note %></dd>
        </div>
      <% end %>
    </dl>

    <div class="mt-6 rounded-lg border border-white/10 bg-white/5 p-4">
      <% if @application.interview %>
        <% iv = @application.interview %>
        <p class="text-sm text-slate-300">
          Interview: <span class="text-slate-100"><%= iv.scheduled_at.to_fs(:long) %></span> · <%= iv.mode_label %>
          <% if iv.cancelled? %><span class="text-rose-300">(cancelled)</span><% end %>
        </p>
        <div class="mt-2 flex flex-wrap gap-2 text-sm">
          <%= link_to "Reschedule", edit_poster_interview_path(iv), class: "rounded-md border border-white/15 px-3 py-1.5 text-slate-200 hover:bg-white/10" %>
          <%= link_to "Open calendar", poster_interviews_path, class: "rounded-md border border-white/15 px-3 py-1.5 text-slate-300 hover:bg-white/10" %>
        </div>
      <% elsif !@application.closed? %>
        <%= link_to "Schedule interview", new_poster_interview_path(application_id: @application.id),
              class: "inline-block rounded-lg bg-violet-500/90 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500" %>
        <p class="mt-2 text-xs text-slate-500">Moves this applicant to the interview stage and notifies them. (Resume review &amp; AI matching arrive later.)</p>
      <% end %>
    </div>

    <div class="mt-6">
      <%= form_with url: conversations_path, method: :post, class: "flex gap-2" do %>
        <%= hidden_field_tag :recipient_id, @application.applicant_id %>
        <%= text_field_tag :body, "Hi #{@application.applicant.display_name}, thanks for applying to #{@application.job_posting.title}.",
              class: "flex-1 rounded-lg border border-white/10 bg-slate-800 px-3 py-2 text-sm text-slate-100" %>
        <%= submit_tag "Message applicant", class: "rounded-lg border border-white/15 px-3 py-2 text-sm text-slate-200 hover:bg-white/10 cursor-pointer" %>
      <% end %>
    </div>

    <% if @application.onboarding_active? %>
      <div class="mt-6 rounded-lg border border-white/10 bg-white/5 p-4">
        <p class="text-sm font-medium text-slate-200">Onboarding documents</p>
        <% docs = @application.onboarding_documents.select(&:attached?) %>
        <% if docs.any? %>
          <ul class="mt-2 space-y-1 text-sm">
            <% docs.each do |d| %>
              <li class="flex items-center justify-between gap-2">
                <span class="text-slate-300"><%= d.label %> — <%= d.file_name %></span>
                <%= link_to "View", d.file_url, target: "_blank", rel: "noopener", class: "text-cyan-300 hover:text-cyan-200" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-1 text-xs text-slate-500">Waiting on the applicant to upload their onboarding items.</p>
        <% end %>
      </div>
    <% end %>

    <% unless @application.closed? %>
      <div class="mt-6 flex flex-wrap gap-2 border-t border-white/10 pt-6">
        <% if @application.advanceable? %>
          <%= button_to "Advance to #{Application::NEXT_STAGE[@application.stage].humanize.titleize}",
                advance_poster_application_path(@application), method: :patch,
                class: "rounded-lg bg-cyan-500 px-5 py-2.5 font-semibold text-slate-950 hover:bg-cyan-400" %>
        <% end %>
        <%= button_to "Reject", reject_poster_application_path(@application), method: :patch,
              form: { data: { turbo_confirm: "Reject this applicant?" } },
              class: "rounded-lg border border-rose-500/30 px-5 py-2.5 text-rose-300 hover:bg-rose-500/10" %>
      </div>
    <% end %>
  </div>
</div>
